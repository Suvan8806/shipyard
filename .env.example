# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres, transaction pooler URI (port 6543). Server only.
# Used for BOTH the platform tables (public) and the live system tables (sys).
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase API (optional; only needed for Realtime or supabase-js features)
NEXT_PUBLIC_SUPABASE_URL=https://oicyziasyqufalmvoulp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers. Model strings are "<provider>/<model>": google/... uses Gemini, groq/... uses Groq.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Optional alternatives: anthropic/... (direct) or any other string via the Vercel AI Gateway.
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# Model profiles: "fast" (tests, reply judge, variants) and "careful" (agents, scenario generator).
SHIPYARD_FAST_MODEL=google/gemini-3.5-flash-lite
SHIPYARD_CAREFUL_MODEL=google/gemini-3.5-flash
# Comma-separated fallback chain, tried in order when a model is rate-limited or unavailable.
SHIPYARD_FALLBACK_MODELS=google/gemini-3.5-flash-lite,groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b

# Platform behavior
SHIPYARD_COMPANY_DOMAIN=lonestarcu.org
SHIPYARD_ADMIN_TOKEN=
SHIPYARD_MAX_DEPLOYS_PER_HOUR=20
SHIPYARD_DEMO_REPLAY=0
# Parallel gate workers per deploy (1-16).
SHIPYARD_GATE_CONCURRENCY=6
# Hard spend cap in USD across all model calls (sum of runs.cost_usd).
SHIPYARD_BUDGET_USD=8
# Optional: shared secret for internal gate fan-out calls (derived from SUPABASE_DB_URL if blank).
SHIPYARD_INTERNAL_SECRET=

# CLI + traffic simulator target
SHIPYARD_API_URL=http://localhost:3000
