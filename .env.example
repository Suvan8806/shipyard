# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres, transaction pooler URI (port 6543). Server only.
# Used for BOTH the platform tables (public) and the live system tables (sys).
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase API (optional; only needed for Realtime or supabase-js features)
NEXT_PUBLIC_SUPABASE_URL=https://oicyziasyqufalmvoulp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM. Set ANTHROPIC_API_KEY (direct provider) or AI_GATEWAY_API_KEY (Vercel AI Gateway).
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
SHIPYARD_FAST_MODEL=anthropic/claude-haiku-4-5
SHIPYARD_CAREFUL_MODEL=anthropic/claude-sonnet-5-5

# Platform behavior
SHIPYARD_COMPANY_DOMAIN=lonestarcu.org
SHIPYARD_ADMIN_TOKEN=
SHIPYARD_MAX_DEPLOYS_PER_HOUR=20
SHIPYARD_DEMO_REPLAY=0

# CLI + traffic simulator target
SHIPYARD_API_URL=http://localhost:3000
