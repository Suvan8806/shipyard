  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Notice Blue action button (Deploy, Run the gate again). Blue is never a status.",
      "html": "<button class=\"ds-btn-primary\">Deploy</button>",
      "css": ".ds-btn-primary{background:var(--primary);color:var(--primary-foreground);height:32px;padding:0 10px;border:1px solid transparent;border-radius:6px;font:500 14px/1 var(--font-archivo),ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "status-pill-failed",
      "description": "Icon + word + ink. Failed and blocked are solid; everything else is tinted.",
      "html": "<span class=\"ds-pill ds-pill-fail\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86z\"/><path d=\"m15 9-6 6M9 9l6 6\"/></svg>Failed</span> <span class=\"ds-pill ds-pill-blocked\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg>Blocked</span> <span class=\"ds-pill ds-pill-live\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>Live</span> <span class=\"ds-pill ds-pill-running\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-dasharray=\"3 3\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>Running</span> <span class=\"ds-pill ds-pill-draft\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 21h8\"/><path d=\"M21.17 6.81a2.83 2.83 0 0 0-4-4L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.62l4.35-1.32a2 2 0 0 0 .83-.5z\"/></svg>Draft</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;padding:2px 6px;border:1px solid;border-radius:3px;font:600 12px/16px var(--font-archivo),ui-sans-serif,sans-serif;white-space:nowrap}.ds-pill-fail{background:var(--fail-solid);color:var(--fail-solid-foreground);border-color:var(--fail-solid)}.ds-pill-blocked{background:var(--blocked-solid);color:var(--blocked-solid-foreground);border-color:var(--blocked-solid)}.ds-pill-live{background:var(--pass-subtle);color:var(--pass);border-color:var(--pass-border)}.ds-pill-running{background:var(--running-subtle);color:var(--running);border-color:var(--running-border)}.ds-pill-draft{background:var(--draft-subtle);color:var(--draft);border-color:var(--border)}"
    },
    {
      "name": "Scenario Tag (failed)",
      "kind": "card",
      "refersTo": "scenario-tag",
      "description": "The signature: solid FAILED band with the eyelet, End state over Reply check, proof on the tag.",
      "html": "<article class=\"ds-tag\"><div class=\"ds-band\"><span class=\"ds-eyelet\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86z\"/><path d=\"m15 9-6 6M9 9l6 6\"/></svg></span><span class=\"ds-sw ds-sw-band\">Failed</span><span class=\"ds-code\">MS-03</span></div><div class=\"ds-tag-body\"><h3 class=\"ds-tag-title\">second-credit-this-month</h3><div class=\"ds-row\"><span class=\"ds-field\">End state</span><span class=\"ds-sw ds-sw-fail\">Fail</span></div><div class=\"ds-assert\">credits where account_id=A-100: count &le; 1 &middot; got <b>2</b></div><div class=\"ds-row ds-quiet\"><span class=\"ds-field\">Reply check</span><span>Pass</span></div><p class=\"ds-callout\">A reply-only eval would have shipped this.</p><a class=\"ds-link\" href=\"#\">View run</a></div></article>",
      "css": ".ds-tag{display:flex;flex-direction:column;overflow:hidden;max-width:560px;background:var(--card);color:var(--card-foreground);border:1px solid var(--fail-solid);border-radius:4.5px;font-family:var(--font-archivo),ui-sans-serif,sans-serif}.ds-band{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--fail-solid);color:var(--fail-solid-foreground)}.ds-eyelet{display:grid;place-items:center;width:28px;height:28px;border-radius:9999px;border:1.5px solid color-mix(in oklch,currentColor 60%,transparent)}.ds-sw{font-stretch:78%;font-weight:750;letter-spacing:.04em;text-transform:uppercase;line-height:1}.ds-sw-band{font-size:24px}.ds-sw-fail{font-size:22px;color:var(--fail)}.ds-code{margin-left:auto;font:11px/16px var(--font-geist-mono),ui-monospace,monospace}.ds-tag-body{display:flex;flex-direction:column;gap:10px;padding:10px 12px 12px}.ds-tag-title{margin:0;font-size:18px;font-weight:600;line-height:1.25}.ds-row{display:flex;align-items:baseline;gap:12px}.ds-field{width:96px;flex-shrink:0;font-size:12px;line-height:16px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-foreground)}.ds-quiet{color:var(--muted-foreground);font-size:14px;font-weight:600}.ds-assert{font:13px/1.4 var(--font-geist-mono),ui-monospace,monospace;color:var(--muted-foreground)}.ds-assert b{color:var(--fail)}.ds-callout{margin:0;padding:8px 12px;border:1px solid var(--fail-border);border-radius:4.5px;background:var(--fail-subtle);color:var(--fail);font-size:14px;font-weight:600}.ds-link{align-self:flex-end;color:var(--primary);font-size:14px;font-weight:500;text-decoration:none}.ds-link:hover{text-decoration:underline}.ds-link:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Scenario Tag (void error)",
      "kind": "card",
      "refersTo": "scenario-tag",
      "description": "Infrastructure error: dashed warn outline, no band, \"not graded\". Never shown as a FAIL.",
      "html": "<article class=\"ds-void\"><div class=\"ds-void-head\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4M12 17h.01\"/></svg><span class=\"ds-void-word\">Error</span><span class=\"ds-void-note\">not graded</span><span class=\"ds-void-code\">MS-07</span></div><h3 class=\"ds-void-title\">refund-over-limit</h3></article>",
      "css": ".ds-void{max-width:320px;background:var(--card);border:1px dashed var(--warn-border);border-radius:4.5px;padding:10px 12px 12px;font-family:var(--font-archivo),ui-sans-serif,sans-serif}.ds-void-head{display:flex;align-items:center;gap:8px;color:var(--warn)}.ds-void-word{font-size:14px;line-height:1;font-stretch:78%;font-weight:750;letter-spacing:.04em;text-transform:uppercase}.ds-void-note{font-size:12px;font-weight:500;color:var(--muted-foreground)}.ds-void-code{margin-left:auto;font:11px var(--font-geist-mono),monospace;color:var(--muted-foreground)}.ds-void-title{margin:4px 0 0;font-size:18px;font-weight:600}"
    },
    {
      "name": "Lockout Banner",
      "kind": "custom",
      "refersTo": "lockout-banner",
      "description": "The lockout tag at page scale: says what is still protected.",
      "html": "<div class=\"ds-lockout\" role=\"status\"><span class=\"ds-lock-eyelet\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg></span><div class=\"ds-lock-text\"><p class=\"ds-lock-line\"><span class=\"ds-lock-word\">Blocked.</span><span class=\"ds-lock-sentence\">v1 is still serving.</span></p><p class=\"ds-lock-sub\">2 of 38 tests failed on the data &middot; 1 critical</p></div><button class=\"ds-lock-btn\">View failing run</button></div>",
      "css": ".ds-lockout{display:flex;align-items:center;gap:16px;padding:20px;border-radius:6px;background:var(--blocked-solid);color:var(--blocked-solid-foreground);font-family:var(--font-archivo),ui-sans-serif,sans-serif}.ds-lock-eyelet{display:grid;place-items:center;width:48px;height:48px;flex-shrink:0;border-radius:9999px;border:2px solid color-mix(in oklch,currentColor 60%,transparent)}.ds-lock-text{flex:1;min-width:0}.ds-lock-line{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;margin:0}.ds-lock-word{font-size:48px;line-height:1;font-stretch:78%;font-weight:750;letter-spacing:.04em;text-transform:uppercase}.ds-lock-sentence{font-size:28px;font-weight:500}.ds-lock-sub{margin:6px 0 0;font-size:15px;opacity:.9}.ds-lock-btn{height:32px;padding:0 10px;border:0;border-radius:6px;background:var(--blocked-solid-foreground);color:var(--blocked);font:500 14px var(--font-archivo),sans-serif;cursor:pointer}.ds-lock-btn:hover{background:color-mix(in oklch,var(--blocked-solid-foreground) 90%,transparent)}.ds-lock-btn:focus-visible{outline:2px solid currentColor;outline-offset:2px}"
    },
    {
      "name": "Filter Segments",
      "kind": "nav",
      "refersTo": "filter-segment-active",
      "description": "Segmented filter with counts in the label; the active segment fills Notice Blue.",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button class=\"ds-seg-btn\" role=\"tab\" aria-selected=\"true\">All 46</button><button class=\"ds-seg-btn\" role=\"tab\">Failed 1</button><button class=\"ds-seg-btn\" role=\"tab\">Critical 1</button><button class=\"ds-seg-btn\" role=\"tab\">Not graded 20</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;background:var(--card);border:1px solid var(--border);border-radius:4.5px;font:500 14px var(--font-archivo),sans-serif}.ds-seg-btn{padding:6px 12px;border:0;border-radius:3px;background:transparent;color:var(--muted-foreground);font:inherit;font-variant-numeric:tabular-nums;cursor:pointer;transition:color 150ms}.ds-seg-btn:hover{color:var(--foreground)}.ds-seg-btn[aria-selected=\"true\"]{background:var(--primary);color:var(--primary-foreground)}.ds-seg-btn:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "rail",
      "description": "The committed Notice-blue shell rail with the tag-glyph wordmark and nav.",
      "html": "<aside class=\"ds-rail\"><div class=\"ds-wordmark\"><svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><rect x=\"1.5\" y=\"3\" width=\"13\" height=\"10\" rx=\"2\"/><circle cx=\"5\" cy=\"8\" r=\"1.4\"/></svg>Shipyard</div><nav class=\"ds-rail-nav\"><a class=\"ds-rail-item is-active\" href=\"#\">Agents</a><a class=\"ds-rail-item\" href=\"#\">Library</a><a class=\"ds-rail-item\" href=\"#\">Approvals<span class=\"ds-rail-badge\">2</span></a><a class=\"ds-rail-item\" href=\"#\">Audit</a></nav></aside>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:24px;width:232px;padding:16px;background:var(--sidebar);color:var(--sidebar-foreground);font-family:var(--font-archivo),sans-serif}.ds-wordmark{display:flex;align-items:center;gap:8px;font-size:18px;font-weight:700;letter-spacing:-.01em}.ds-rail-nav{display:flex;flex-direction:column;gap:4px}.ds-rail-item{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:4.5px;color:var(--sidebar-muted);font-size:14px;font-weight:500;text-decoration:none;transition:background-color 150ms,color 150ms}.ds-rail-item:hover{background:color-mix(in oklch,var(--sidebar-accent) 60%,transparent);color:var(--sidebar-foreground)}.ds-rail-item.is-active{background:var(--sidebar-accent);color:var(--sidebar-accent-foreground)}.ds-rail-item:focus-visible{outline:2px solid var(--sidebar-ring);outline-offset:2px}.ds-rail-badge{margin-left:auto;padding:0 6px;border-radius:3px;background:var(--sidebar-primary);color:var(--sidebar-primary-foreground);font-size:11px;font-weight:600}"
    },
    {
      "name": "Twin Diff Table",
      "kind": "custom",
      "refersTo": "diff-row-added",
      "description": "Mono diff rows with a + / − / ~ glyph column so the diff reads without color; changed cells show before → after.",
      "html": "<table class=\"ds-diff\"><thead><tr><th></th><th>account_id</th><th>amount</th><th>note</th></tr></thead><tbody><tr class=\"ds-ctx\"><td></td><td>A-100</td><td>$25.00</td><td>\"Goodwill credit\"</td></tr><tr class=\"ds-add\"><td class=\"ds-g\">+</td><td>A-100</td><td>$25.00</td><td>\"Goodwill credit\"</td></tr><tr class=\"ds-chg\"><td class=\"ds-g\">~</td><td>A-100</td><td class=\"ds-cell\"><span class=\"ds-before\">$0.00</span> &rarr; &minus;$25.00</td><td></td></tr></tbody></table>",
      "css": ".ds-diff{border-collapse:collapse;border:1px solid var(--border);font:12px/1.4 var(--font-geist-mono),ui-monospace,monospace;font-variant-numeric:tabular-nums}.ds-diff th{padding:6px 8px;text-align:left;font-weight:500;color:var(--muted-foreground);background:color-mix(in oklch,var(--muted) 60%,transparent);border-bottom:1px solid var(--border)}.ds-diff td{padding:6px 8px;border-top:1px solid var(--border);white-space:nowrap}.ds-g{width:24px;text-align:center;font-weight:700}.ds-ctx{color:var(--muted-foreground)}.ds-add{background:var(--diff-add-bg)}.ds-add .ds-g{color:var(--diff-add)}.ds-chg{background:var(--diff-change-bg)}.ds-chg .ds-g{color:var(--diff-change)}.ds-cell{background:var(--diff-cell);font-weight:600}.ds-before{color:var(--muted-foreground)}"
    }
  ],
  "narrative": {
    "northStar": "The Inspection Tag",
    "overview": "A deploy is an inspection, and every scenario is a tag hung on the version. Passing tags are quiet: an icon, a condensed word, a name. A failing tag is loud: a solid red band across its top, the punched eyelet around its icon, the proof printed on the tag itself. When the data is wrong the whole version gets a lockout tag at page scale, and that banner says what is still protected. The rest of the interface stays out of the way: a cool tag-stock ground, a committed Notice-blue rail, 1px rules, crisp small corners, standard shadcn controls.\n\nThis is an Operate-mode working tool built to read from the back of a room. Light is the projector theme and the default; dark is fully supported through the `.dark` class (next-themes, storage key `sy-theme`). Density is table-dense with generous emphasis reserved for verdicts: one strip of big numerals, one banner, one band per failure. Nothing in the world is decorative except the eyelet ring.\n\nThe world refuses the grey dashboard of identical green and red pills where the reply grade weighs as much as the data grade. No gradients beyond the functional running sheen, no glass, no glow, no hero-metric cards.",
    "keyCharacteristics": [
      "Asymmetric verdict weight: failures carry solid bands, passes carry only icon + word.",
      "Safety inks (green, red, lockout red, caution yellow, amber) carry state and nothing else; Notice blue carries action and nothing else.",
      "One family, two voices: Archivo at normal width for UI, Archivo condensed caps (wdth 78, weight 750) for status words.",
      "Geist Mono only for data: spec YAML, assertions, diffs, run ids, money, durations.",
      "Flat surfaces separated by 1px rules; no shadows at rest.",
      "One authored motion moment: the verdict landing on a tag."
    ],
    "rules": [
      {
        "name": "The Notice Blue Rule",
        "body": "Blue means \"you can act here\" and is never a status. Green, red, and yellow mean state and are never a button fill.",
        "section": "colors"
      },
      {
        "name": "The Loud Failure Rule",
        "body": "Only FAILED and BLOCKED get solid fills. Passed, live, running pill, error, and draft get a tint or nothing. The ink-weight difference, not hue, is what makes the one bad tag findable and what keeps the board legible in greyscale.",
        "section": "colors"
      },
      {
        "name": "The Never Color Alone Rule",
        "body": "Every status is icon + word + color, and the icons differ in shape: circle-check (pass, live), octagon-x (fail), dashed ring (running), padlock (blocked), triangle (error, warn), pencil (draft).",
        "section": "colors"
      },
      {
        "name": "The Separate Ambers Rule",
        "body": "Running and warn share the amber family, so they never appear in the same component. A running tag has no warnings; warn lives in diffs, coverage, errors, and void tags.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "The condensed verdict voice comes from Archivo's width axis, not a second display face. Status words always use the status-word setting.",
        "section": "typography"
      },
      {
        "name": "The Mono Is Evidence Rule",
        "body": "Monospace is for data, code, and money only. Labels and prose stay in Archivo.",
        "section": "typography"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Tables, counters, costs, and diffs always use tabular numerals. Money reads `$25.00` in diffs, `−$25.00` with a true minus for negatives, and four decimals for sub-cent run costs (`$0.0041`).",
        "section": "typography"
      },
      {
        "name": "The Rules Over Shadows Rule",
        "body": "Separate with 1px rules and tonal steps. A new surface earns no shadow unless it floats above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair every status with a shape-distinct lucide icon, a word, and its ink.",
      "Do reserve solid fills for FAILED and BLOCKED; keep passed tags to icon + word.",
      "Do put End state above Reply check, at full weight, with Reply check in quiet ink.",
      "Do show proof beside each verdict: expected · got in mono and the mini diff on the tag.",
      "Do render infrastructure errors as dashed \"not graded\" void tags and label pass rate \"(graded)\" when errors exist.",
      "Do use the status-word setting (Archivo wdth 78, 750, caps, +0.04em) for every status word, never below 14px.",
      "Do keep motion to 150-200ms state transitions, plus the tag flip and banner drop on live transitions only; under reduced motion every duration collapses to zero and verdicts snap.",
      "Do start every animated element from a visible state."
    ],
    "donts": [
      "Don't use Notice Blue for a status or a safety ink for a button.",
      "Don't show running and warn amber in the same component.",
      "Don't add shadows to tags, panels, or banners.",
      "Don't add gradients other than the running sheen, gradient text, glass, glow, or purple.",
      "Don't add hero-metric card rows; counts live in the one counters strip.",
